#version 450
layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 6) buffer Keys    { float keys[]; };
layout(std430, set = 0, binding = 7) buffer Indices { uint  indices[]; };

layout(push_constant) uniform Push { uint count; uint n_pad; uint j; uint k; } pc;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n_pad) return;

    uint l = i ^ pc.j;              // my partner this pass
    if (l <= i) return;             // the lower index of each pair does the work

    bool  ascending = (i & pc.k) == 0u;
    float ki = keys[i];
    float kl = keys[l];

    if (ascending ? (ki > kl) : (ki < kl)) {
        keys[i] = kl;  keys[l] = ki;
        uint t = indices[i];  indices[i] = indices[l];  indices[l] = t;
    }
}