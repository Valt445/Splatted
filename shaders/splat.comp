#version 450
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) uniform UBO { mat4 proj; mat4 view; vec2 viewport; vec2 focal; } ubo;
layout(std430, set = 0, binding = 1) readonly  buffer Positions { float positions[]; };
layout(std430, set = 0, binding = 6) writeonly buffer Keys      { float keys[]; };
layout(std430, set = 0, binding = 7) writeonly buffer Indices   { uint  indices[]; };
layout(push_constant) uniform Push { uint count; uint n_pad; uint j; uint k; } pc;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n_pad) return;

    if (i < pc.count) {
        vec3 p = vec3(positions[3*i], positions[3*i+1], positions[3*i+2]);
        keys[i]    = (ubo.view * vec4(p, 1.0)).z;
        indices[i] = i;
    } else {
        keys[i]    = 3.0e38;
        indices[i] = 0;
    }
}