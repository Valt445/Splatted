#version 450
layout(local_size_x = 256) in;


layout(std430, set = 0, binding = 1) readonly buffer Positions { float positions[]; };
layout(std430, set = 0, binding = 2) readonly buffer Rotations { vec4  rotations[]; };
layout(std430, set = 0, binding = 3) readonly buffer Scales    { float scales[]; };
layout(std430, set = 0, binding = 4) readonly buffer Opacities { float opacities[]; };
layout(std430, set = 0, binding = 9) readonly buffer Awake { uint awake[]; };
layout(std430, set = 0, binding = 10) buffer Density { uint density[]; };
layout(std430, set = 0, binding = 13) readonly buffer Grid { vec4 origin_size; uvec4 dims; } grid;
layout(push_constant) uniform Push { uint count; } pc;

mat3 quat_to_mat(vec4 q) { float x = q.x, y = q.y, z = q.z, w = q.w;
    return mat3(1.0 - 2.0*(y*y + z*z), 2.0*(x*y + w*z),       2.0*(x*z - w*y),
                2.0*(x*y - w*z),       1.0 - 2.0*(x*x + z*z), 2.0*(y*z + w*x),
                2.0*(x*z + w*y),       2.0*(y*z - w*x),       1.0 - 2.0*(x*x + y*y)); }

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;
    float op = opacities[i];
    if(op < 0.3) return;
    float vs = grid.origin_size.w;
    vec3 mu = vec3(positions[3*i], positions[3*i+1], positions[3*i+2]);
    vec3 s = vec3(scales[3*i], scales[3*i+1], scales[3*i+2]);
    if (max(s.x, max(s.y, s.z)) > 12.0 * vs) return;
    if (awake[i] != 0u) return;
    s = sqrt(s * s + 0.25 * vs * vs);

    mat3 R = quat_to_mat(normalize(rotations[i]));
    float smax = max(s.x, max(s.y, s.z));
    int r = clamp(int(ceil(2.0 * smax / vs)), 0, 6);

    ivec3 dims = ivec3(grid.dims.xyz);
    ivec3 c    = ivec3(floor((mu - grid.origin_size.xyz) / vs));

    for (int dz = -r; dz <= r; dz++)
    for (int dy = -r; dy <= r; dy++)
    for (int dx = -r; dx <= r; dx++) {
        ivec3 v = c + ivec3(dx, dy, dz);
        if (any(lessThan(v, ivec3(0))) || any(greaterThanEqual(v, dims))) continue;

        vec3  center = grid.origin_size.xyz + (vec3(v) + 0.5) * vs;
        vec3  d      = transpose(R) * (center - mu);
        vec3  q      = d / s;
        float m2     = dot(q, q);
        if (m2 > 4.0) continue;

        float w   = op * exp(-0.5 * m2);
        uint  idx = uint(v.x) + uint(v.y) * grid.dims.x + uint(v.z) * grid.dims.x * grid.dims.y;
        atomicAdd(density[idx], uint(w * 1000.0));
    }
}